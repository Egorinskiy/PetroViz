# ==========================================
# PetroViz Backend Configuration
# ==========================================
# Скопируй в .env и заполни реальными значениями:
#   cp .env.example .env
#
# Файл .env НЕ коммитится в git.

# --- Application ---
PETROVIZ_DEBUG=false
PETROVIZ_LOG_LEVEL=INFO

# --- CORS (список доменов через запятую) ---
PETROVIZ_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
PETROVIZ_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5433/DBNAME
PETROVIZ_TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5433/petroviz_test

# --- Auth ---
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
PETROVIZ_JWT_SECRET=CHANGE_ME
PETROVIZ_JWT_ALGORITHM=HS256
PETROVIZ_ACCESS_TOKEN_EXPIRE_MINUTES=30
PETROVIZ_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage ---
PETROVIZ_WELL_DATA_DIR=storage/wells

# --- Опциональные (дефолты в app/settings.py) ---
# PETROVIZ_APP_NAME=PetroViz API
# PETROVIZ_APP_VERSION=0.3.0
# PETROVIZ_MAX_FILE_SIZE_BYTES=52428800
# PETROVIZ_MAX_POINTS_DEFAULT=5000
# PETROVIZ_MAX_POINTS_HARD_LIMIT=100000
# PETROVIZ_ADAPTIVE_POINTS_PER_METER=10
# PETROVIZ_ADAPTIVE_MIN_POINTS=500
# PETROVIZ_ADAPTIVE_MAX_POINTS=20000
# PETROVIZ_PIXEL_OVERSAMPLE=2.0
# PETROVIZ_PIXEL_MIN_WIDTH=100
# PETROVIZ_PIXEL_MAX_WIDTH=4000