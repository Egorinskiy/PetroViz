{
  "dest": "USER_GUIDE.pdf",
  "stylesheet": "docs/USER_GUIDE.css",
  "body_class": "user-guide",
  "pdf_options": {
    "format": "A4",
    "printBackground": true,
    "margin": {
      "top": "20mm",
      "right": "15mm",
      "bottom": "22mm",
      "left": "15mm"
    },
    "displayHeaderFooter": true,
    "headerTemplate": "<div style=\"width:100%;font-family:'Geist Sans',sans-serif;font-size:8pt;color:#999;padding:0 15mm;display:flex;justify-content:space-between;align-items:center;\"><span>PetroViz — Руководство пользователя</span><span>2026</span></div>",
    "footerTemplate": "<div style=\"width:100%;font-family:'Geist Sans',sans-serif;font-size:8pt;color:#999;text-align:center;\"><span class=\"pageNumber\"></span> / <span class=\"totalPages\"></span></div>"
  },
  "launch_options": {
    "args": ["--no-sandbox", "--font-render-hinting=none"]
  },
  "marked_options": {
    "headerIds": true,
    "mangle": false,
    "gfm": true,
    "breaks": false
  }
}